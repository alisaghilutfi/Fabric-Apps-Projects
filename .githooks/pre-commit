#!/bin/sh
# Fabric-Apps profile pre-commit — blocks rayfin runtime artefacts and secrets.

# Block rayfin runtime files.
rayfin_hits=$(git diff --cached --name-only --diff-filter=ACM \
  | grep -E '^rayfin/\.env$|^rayfin/\.temp/|^rayfin/\.deployments\.json$')
if [ -n "$rayfin_hits" ]; then
  echo "Blocked: rayfin runtime files must not be committed:"
  echo "$rayfin_hits"
  echo "These files hold live deploy state or secrets (override: git commit --no-verify)."
  exit 1
fi

# Secret scanning — block Azure SP secrets, connection strings, bearer tokens.
SECRET_PAT='"client[Ss]ecret"[[:space:]]*:[[:space:]]*"[^"]{8,}"|AccountKey=[A-Za-z0-9+/]{20,}={0,2}|SharedAccessSignature=[^"&[:space:]]{20,}|[Bb]earer[[:space:]]+ey[A-Za-z0-9._-]{20,}|password[[:space:]]*=[[:space:]]*[A-Za-z0-9!@#$%^&*]{8,}'
secrets=$(git diff --cached -U0 --diff-filter=ACM \
  | grep -E '^\+' \
  | grep -ivE '^\+\+\+' \
  | grep -E "$SECRET_PAT")
if [ -n "$secrets" ]; then
  echo "Blocked: possible secrets in staged changes:"
  echo "$secrets"
  echo "Remove secrets before committing (override: git commit --no-verify)."
  exit 1
fi

exit 0

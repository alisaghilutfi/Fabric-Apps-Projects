{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File C:/Users/alisa/DS-ML-DL/Fabric-Apps-Projects/.claude/hooks/session-start.ps1",
            "timeout": 90
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File C:/Users/alisa/DS-ML-DL/Fabric-Apps-Projects/.claude/hooks/post-edit-rayfin.ps1"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "fabric-data-app@power-bi-agentic-development": true
  },
  "pluginConfigs": {
    "fabric-data-app@power-bi-agentic-development": {
      "options": {
        "glyphs": "plain",
        "follow": "on",
        "fontHint": "on"
      }
    }
  }
}
